# ============================================================
# CONTOH KONFIGURASI ENVIRONMENT — Brookies
# ------------------------------------------------------------
# Salin file ini menjadi .env, lalu isi nilai sesuai lingkungan Anda.
# JANGAN pernah memasukkan nilai asli ke file yang di-commit.
# ============================================================

# Database MySQL (database yang dipakai: brookies_db)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=brookies_db

# Jumlah koneksi dalam pool MySQL
DB_CONNECTION_LIMIT=10

# Port backend Express
PORT=3000

# Secret untuk menandatangani token JWT (wajib diisi, gunakan string acak panjang)
JWT_SECRET=ganti_dengan_secret_acak_anda
JWT_EXPIRES_IN=8h

# Alamat frontend yang diizinkan mengakses API (CORS)
CORS_ORIGIN=http://localhost:5173

# (Opsional,frontend) Alamat backend yang dipakai Vite.
# Jika kosong, frontend memakai http://localhost:3000.
VITE_API_URL=http://localhost:3000

# Akun admin awal — hanya dipakai oleh: node server/seedAdmin.js
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
