# ============================================================
# CONTOH KONFIGURASI ENVIRONMENT — Brookies
# ------------------------------------------------------------
# Salin file ini menjadi .env, lalu isi nilai sesuai lingkungan Anda.
# JANGAN pernah memasukkan nilai asli ke file yang di-commit.
# ============================================================

# Database MySQL (database yang dipakai: brookies_db)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=brookies_db

# Jumlah koneksi dalam pool MySQL
DB_CONNECTION_LIMIT=10

# TLS MySQL: false untuk lokal, true untuk penyedia terkelola.
# DB_SSL_CA opsional, berisi path ke file CA jika penyedia memerlukannya.
DB_SSL=false
DB_SSL_CA=

# Port backend Express
PORT=3000

# Mode aplikasi. Isi production di hosting; kosongkan untuk pengembangan lokal.
NODE_ENV=

# Secret untuk menandatangani token JWT (wajib diisi, gunakan string acak panjang).
# Pakai secret berbeda untuk setiap environment; jangan memakai nilai contoh di produksi.
JWT_SECRET=ganti_dengan_secret_acak_anda
JWT_EXPIRES_IN=8h

# Alamat frontend yang diizinkan mengakses API (CORS). Pisahkan beberapa origin dengan koma.
CORS_ORIGIN=http://localhost:5173

# (Frontend, WAJIB untuk build production) Alamat backend yang dipakai Vite.
# Saat development, variabel ini boleh kosong sehingga memakai http://localhost:3000.
VITE_API_URL=http://localhost:3000

# Akun admin awal — hanya dipakai oleh: node server/seedAdmin.js
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
